{
  "name": "prox-gallery-admin-ui",
  "private": true,
  "version": "0.2.0-rc.1",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.admin.config.js",
    "build": "vite build --config vite.admin.config.js",
    "preview": "vite preview --config vite.admin.config.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write assets/admin/src assets/frontend dev tests/ui *.json *.js",
    "format:check": "prettier --check assets/admin/src assets/frontend dev tests/ui *.json *.js"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.2.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.575.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.2.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "tailwindcss": "4.2.1",
    "typescript": "7.0.2",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  }
}
